{
  "name": "word-map",
  "author": "lumine-code",
  "description": "Convert short text triggers into Greek letters and symbols.",
  "repository": "https://github.com/lumine-code/word-map",
  "bugs": {
    "url": "https://github.com/lumine-code/word-map/issues"
  },
  "keywords": [
    "greek",
    "symbols",
    "unicode",
    "substitution",
    "conversion",
    "characters"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "activationCommands": {
    "atom-text-editor": [
      "word-map:auto",
      "word-map:selected",
      "word-map:fixed-1",
      "word-map:fixed-2",
      "word-map:fixed-3",
      "word-map:fixed-4",
      "word-map:fixed-5"
    ]
  },
  "configSchema": {
    "silentQ": {
      "title": "Silent Mode",
      "description": "Silence the warning notifications.",
      "type": "boolean",
      "default": false
    },
    "customMAP": {
      "title": "Custom Mapping",
      "description": "Custom mapping rules. This field should be a valid dictionary mapping without brackets e.g. `s:σ, σ:s`.",
      "type": "string",
      "default": ""
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}
