{
  "name": "word-map",
  "author": "lumine-code",
  "description": "Convert short text triggers into Greek letters and symbols.",
  "repository": "https://github.com/lumine-code/word-map",
  "bugs": {
    "url": "https://github.com/lumine-code/word-map/issues"
  },
  "keywords": [
    "greek",
    "symbols",
    "unicode",
    "substitution",
    "conversion",
    "characters"
  ],
  "version": "1.0.0",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "silentQ": {
      "title": "Silent Mode",
      "description": "Silence the warning notifications.",
      "type": "boolean",
      "default": false
    },
    "customMAP": {
      "title": "Custom Mapping",
      "description": "Custom mapping rules. This field should be a valid dictionary mapping without brackets e.g. `s:σ, σ:s`.",
      "type": "string",
      "default": ""
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
